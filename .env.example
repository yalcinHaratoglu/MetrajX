# --- Local (Docker PostgreSQL) ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=conmanage
DB_USER=conmanage
DB_PASSWORD=conmanage_dev_secret
DB_HOST=localhost
DB_PORT=5432

# --- Cloud (Neon) — production uses DATABASE_URL ---
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/conmanage?sslmode=require

# Django
SECRET_KEY=change-me-in-production-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend URL (activation emails)
FRONTEND_URL=http://localhost:5173

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT token süreleri
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Frontend (Vercel production)
# VITE_API_URL=https://conmanage-api.onrender.com/api
