{
  "name": "conmanage",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "dev:frontend": "pnpm --filter @conmanage/frontend dev",
    "dev:backend": "pnpm --filter @conmanage/backend dev",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "migrate": "pnpm --filter @conmanage/backend migrate",
    "create-superuser": "pnpm --filter @conmanage/backend create-superuser",
    "setup:db": "docker compose down -v && docker compose up -d && sleep 6 && pnpm migrate && pnpm create-superuser",
    "lint": "pnpm --filter @conmanage/frontend lint",
    "typecheck": "pnpm --filter @conmanage/frontend exec tsc -b --noEmit",
    "build": "pnpm --filter @conmanage/frontend build",
    "test:frontend": "pnpm --filter @conmanage/frontend build",
    "test:backend": "pnpm --filter @conmanage/backend test",
    "test": "pnpm test:backend && pnpm test:frontend",
    "check": "pnpm lint && pnpm typecheck && pnpm test:backend",
    "commit": "node scripts/commit.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@inquirer/prompts": "^7.5.1",
    "concurrently": "^9.1.2",
    "husky": "^9.1.7"
  }
}
