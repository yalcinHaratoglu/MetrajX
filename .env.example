# --- Local (Docker PostgreSQL) ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=metrajx
DB_USER=metrajx
DB_PASSWORD=metrajx_dev_secret
DB_HOST=localhost
DB_PORT=5432

# --- Cloud (Neon) — production uses DATABASE_URL ---
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/metrajx?sslmode=require

# Django
SECRET_KEY=change-me-in-production-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend URL (activation emails)
FRONTEND_URL=http://localhost:5173

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend (Vercel production)
# VITE_API_URL=https://metrajx-api.onrender.com/api
